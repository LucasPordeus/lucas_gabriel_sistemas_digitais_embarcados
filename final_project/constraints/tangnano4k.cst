IO_LOC "clk"        45;
IO_LOC "rst_n"      15;

IO_LOC "sensor_raw" 28;
IO_LOC "botao_raw"  14;

IO_LOC "led_vermelho" 31;
IO_LOC "led_amarelo"  32;
IO_LOC "led_verde"    33;

IO_LOC "led_ped_verde"    34;
IO_LOC "led_ped_vermelho" 35;

IO_LOC "sclk" 39;
IO_LOC "cs_n" 40;
IO_LOC "mosi" 41;
IO_LOC "miso" 42;
IO_LOC "busy" 43;

IO_PORT "clk"        IO_TYPE=LVCMOS33;
IO_PORT "rst_n"      PULL_MODE=UP;
IO_PORT "sensor_raw" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "botao_raw"  PULL_MODE=UP;
IO_PORT "led_vermelho" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_amarelo"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_verde"    IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_ped_verde"    IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_ped_vermelho" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "miso" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "busy" IO_TYPE=LVCMOS33 DRIVE=8;