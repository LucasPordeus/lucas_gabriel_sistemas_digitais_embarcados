// tangnano4k.cst - Constraints de pino (Gowin EDA) - Tang Nano 4K (GW1NSR-LV4C QFN48P)
// Pinout iniciado no TP2/TP3. O TP4 nao adiciona pinos fisicos novos --
// bram_historico e media_movel_dsp sao blocos internos (BRAM/DSP) que nao
// tem pinout proprio, apenas consomem recursos internos do FPGA.
// OBS: numeros de pino baseados no pinout de referencia do kit Sipeed Tang
// Nano 4K; confirmar contra a serigrafia da placa antes de gravar.

// Clock e reset
IO_LOC "clk"        "27";
IO_LOC "rst_n"      "17";

// Entradas digitais (sensor de veiculos e botao de pedestre) -- TP2
IO_LOC "sensor_raw" "28";
IO_LOC "botao_raw"  "29";

// Semaforo de veiculos -- TP2
IO_LOC "led_vermelho" "16";
IO_LOC "led_amarelo"  "15";
IO_LOC "led_verde"    "14";

// Semaforo de pedestre -- TP3
IO_LOC "led_ped_verde"    "13";
IO_LOC "led_ped_vermelho" "12";

// Barramento paralelo ARM -> FPGA -- TP3
IO_LOC "dados[0]" "41";
IO_LOC "dados[1]" "42";
IO_LOC "dados[2]" "43";
IO_LOC "dados[3]" "44";
IO_LOC "dados[4]" "45";
IO_LOC "dados[5]" "46";
IO_LOC "dados[6]" "47";
IO_LOC "dados[7]" "48";
IO_LOC "strobe"   "39";
IO_LOC "ack"      "40";

IO_PORT "clk"        IO_TYPE=LVCMOS33;
IO_PORT "rst_n"      IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "sensor_raw" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "botao_raw"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "led_vermelho" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_amarelo"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_verde"    IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_ped_verde"    IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_ped_vermelho" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dados[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "dados[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "dados[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "dados[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "dados[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "dados[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "dados[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "dados[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "strobe"   IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "ack"      IO_TYPE=LVCMOS33 DRIVE=8;
